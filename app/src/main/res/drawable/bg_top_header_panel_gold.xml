<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Faint Ambient Gold Halo (outer backlight separator) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#0D1A1408" />
            <stroke
                android:width="2dp"
                android:color="#33FFAA30" />
        </shape>
    </item>

    <!-- Deep Warm Matte-Black Glass Surface with Metallic Gold Outline -->
    <item
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#20180F"
                android:centerColor="#0D0B08"
                android:endColor="#080705"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#59441F" />
        </shape>
    </item>

    <!-- Gentle Top Edge Glass Highlight -->
    <item
        android:left="45dp"
        android:right="45dp"
        android:top="1.5dp"
        android:height="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFCC66"
                android:centerColor="#FFCC66"
                android:endColor="#00FFCC66"
                android:type="linear" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- Soft Warm Gold Light Bloom at Bottom Center -->
    <item
        android:left="65dp"
        android:right="65dp"
        android:bottom="1.5dp"
        android:height="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFAA30"
                android:centerColor="#FFAA30"
                android:endColor="#00FFAA30"
                android:type="linear" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
