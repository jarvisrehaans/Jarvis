<?xml version="1.0" encoding="utf-8"?>
<!-- Blue ring + soft glow behind the mic button, matching the reference's
     "border-primary/40 mic-shadow" look. The stroke color/width is nudged by
     MainActivity per orb state (idle / listening / thinking / speaking) so the
     ring reads as "lighting up" when JARVIS's state changes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1.5dp" android:color="#662979FF" />
</shape>
