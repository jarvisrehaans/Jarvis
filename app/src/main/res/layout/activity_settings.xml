<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_mesh">

    <!-- Top AppBar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingStart="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:background="#A6050505"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/backBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_settings_row"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            android:padding="8dp"
            android:contentDescription="Back"
            app:tint="@color/accent_primary" />

        <TextView
            android:id="@+id/settingsTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="JARVIS CONFIG"
            android:textColor="@color/accent_primary"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"
            android:textSize="20sp" />

        <!-- Update Search Button with Notification Dot Indicator -->
        <FrameLayout
            android:id="@+id/headerUpdateSearchContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:id="@+id/headerUpdateSearchBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_settings_row"
                android:src="@drawable/ic_search_update"
                android:padding="9dp"
                android:contentDescription="Check for Updates"
                app:tint="@color/accent_primary" />

            <!-- Pulsing Notification Dot (Visible when update available) -->
            <View
                android:id="@+id/headerUpdateBadgeDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_status_dot"
                android:backgroundTint="#FF3B30"
                android:visibility="gone" />
        </FrameLayout>

        <ImageView
            android:id="@+id/headerSettingsIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings"
            app:tint="@color/accent_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:fillViewport="false"
        android:overScrollMode="always">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- UPDATE APP NOTIFICATION BANNER (Dynamic: visible when update is available) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/updateAppNotificationCard"
                style="@style/SettingsCard"
                app:cardBackgroundColor="#E60A192F"
                app:strokeColor="#00E5FF"
                app:strokeWidth="1.5dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_cloud_download"
                            app:tint="#00E5FF"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="🚀 UPDATE APP AVAILABLE"
                            android:textColor="#00E5FF"
                            android:fontFamily="sans-serif-black"
                            android:textSize="12sp"
                            android:letterSpacing="0.06" />

                        <TextView
                            android:id="@+id/updateNotificationBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_pill_primary"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="v1.4.0 NEW"
                            android:textColor="@color/accent_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/updateNotificationTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="A new version of JARVIS AI is available!"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/updateNotificationChangelog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Real-time voice interruption, physical camera tilt correction, and system performance enhancements."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:maxLines="3"
                        android:ellipsize="end" />

                    <FrameLayout
                        android:id="@+id/updateNotificationActionBtn"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_save_button"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_cloud_download"
                                app:tint="@color/white"
                                android:contentDescription="@null" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="UPDATE APP NOW"
                                android:textColor="@color/white"
                                android:fontFamily="sans-serif-black"
                                android:textSize="13sp"
                                android:letterSpacing="0.04" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ACTIVE ENGINE BANNER -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/activeEngineBannerCard"
                style="@style/SettingsCard"
                app:cardBackgroundColor="#CC0D1B2A"
                app:strokeColor="@color/success"
                app:strokeWidth="1.5dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚡ ACTIVE SPEECH ENGINE"
                            android:textColor="@color/success"
                            android:fontFamily="sans-serif-black"
                            android:textSize="11sp"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/activeEngineBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="● ACTIVE"
                            android:textColor="@color/success"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/activeEngineTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Sarvam AI TTS (bulbul:v3)"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/activeEngineSubtext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Voice: shubh | Lang: Hindi (hi-IN)"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ACCOUNT & SECURITY -->
            <TextView style="@style/SettingsSectionLabel" android:text="ACCOUNT &amp; SECURITY" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- GEMINI API KEY -->
                    <LinearLayout
                        android:id="@+id/geminiKeyContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/apiKeyLabel"
                            style="@style/SettingsFieldLabel"
                            android:text="Gemini API Key" />
                        
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/apiKeyInput"
                                style="@style/SettingsInput"
                                android:inputType="textPassword"
                                android:paddingEnd="48dp"
                                android:hint="Enter Gemini API key" />

                            <ImageButton
                                android:id="@+id/apiKeyVisibilityToggle"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="6dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_visibility"
                                android:contentDescription="Toggle API Key Visibility"
                                app:tint="@color/text_secondary" />
                        </RelativeLayout>
                    </LinearLayout>



                    <TextView
                        style="@style/SettingsFieldLabel"
                        android:layout_marginTop="14dp"
                        android:text="User Name" />

                    <EditText
                        android:id="@+id/userNameInput"
                        style="@style/SettingsInput"
                        android:inputType="textPersonName"
                        android:hint="Enter your name" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- VOICE & INTELLIGENCE -->
            <TextView style="@style/SettingsSectionLabel" android:text="VOICE &amp; INTELLIGENCE" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Jarvis Voices: horizontal scrollable chips -->
                    <TextView
                        android:id="@+id/geminiVoiceLabel"
                        style="@style/SettingsFieldLabel"
                        android:text="Jarvis Voices" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:overScrollMode="always">

                        <LinearLayout
                            android:id="@+id/geminiVoiceChipsRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <!-- HORIZONTAL ROW: APP PERMISSIONS & PREFERRED SIM SIDE-BY-SIDE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <!-- LEFT COLUMN: APP PERMISSIONS -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsFieldLabel"
                                android:text="App Permissions" />

                            <LinearLayout
                                android:id="@+id/permissionsBar"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner_field"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_shield"
                                    app:tint="@color/accent_primary" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif-bold"
                                    android:singleLine="true"
                                    android:text="System Access"
                                    android:textColor="@color/accent_primary"
                                    android:textSize="12sp" />

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="@color/accent_primary" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- RIGHT COLUMN: PREFERRED SIM -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsFieldLabel"
                                android:text="Preferred SIM" />

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:layout_marginTop="4dp">

                                <Spinner
                                    android:id="@+id/simSpinner"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_spinner_field_green"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="28dp"
                                    android:popupBackground="@drawable/bg_dialog"
                                    android:spinnerMode="dropdown" />

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="end|center_vertical"
                                    android:layout_marginEnd="10dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_chevron_down"
                                    app:tint="@color/success" />
                            </FrameLayout>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PERSONALITY MATRIX -->
            <TextView style="@style/SettingsSectionLabel" android:text="PERSONALITY MATRIX" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.jarvis.assistant.ui.settings.SegmentedControl
                        android:id="@+id/personalitySegmented"
                        android:layout_width="match_parent"
                        android:layout_height="44dp" />

                    <TextView
                        android:id="@+id/personalityDescriptionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="italic"
                        android:lineSpacingExtra="3dp"
                        android:text="Warm, caring Hinglish companion with expressive replies." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>



            <!-- HOME SCREEN STYLE -->
            <TextView style="@style/SettingsSectionLabel" android:text="HOME SCREEN STYLE" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.jarvis.assistant.ui.settings.SegmentedControl
                        android:id="@+id/homeStyleSegmented"
                        android:layout_width="match_parent"
                        android:layout_height="44dp" />

                    <TextView
                        android:id="@+id/homeStyleDescriptionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="italic"
                        android:lineSpacingExtra="3dp"
                        android:text="Arc 3D Preview (Classic Reactor with interactive controls) ⚡" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- APPEARANCE & THEME -->
            <TextView
                android:id="@+id/appearanceThemeSectionLabel"
                style="@style/SettingsSectionLabel"
                android:text="APPEARANCE &amp; THEME" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/appearanceThemeCard"
                style="@style/SettingsCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.jarvis.assistant.ui.settings.SegmentedControl
                        android:id="@+id/themeSegmented"
                        android:layout_width="match_parent"
                        android:layout_height="44dp" />

                    <TextView
                        android:id="@+id/themeDescriptionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="italic"
                        android:lineSpacingExtra="3dp"
                        android:text="Arc Blue Theme (Electric Cyan &amp; Deep Space) ⚡" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- APPLICATION UPDATES -->
            <TextView style="@style/SettingsSectionLabel" android:text="APPLICATION UPDATES" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/settingsCheckUpdatesRow"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_settings_row"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:id="@+id/settingsUpdateSearchIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_search_update"
                            app:tint="@color/accent_primary"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="Check for System Updates"
                            android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-bold"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/settingsUpdateStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="Check Now"
                            android:textColor="@color/accent_primary"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/accent_primary"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SAVE BUTTON -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp">

                <TextView
                    android:id="@+id/saveButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:gravity="center"
                    android:text="SAVE &amp; APPLY CONFIGURATION"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:letterSpacing="0.04"
                    android:background="@drawable/bg_save_button"
                    android:elevation="4dp" />
            </FrameLayout>

            <!-- APP VERSION FOOTER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/appVersionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ JARVIS AI v3.1.0 (Build 55)"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Continuous Voice Execution Engine • Android 10.0+"
                    android:textColor="#64748B"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
