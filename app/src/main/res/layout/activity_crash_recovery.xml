<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FF1A1A2E">

    <!-- Sad robot emoji -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="😵"
        android:textSize="72sp"
        android:layout_marginBottom="24dp" />

    <!-- Friendly title -->
    <TextView
        android:id="@+id/crashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Oops! Jarvis ran into a problem"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Simple explanation -->
    <TextView
        android:id="@+id/crashMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Don't worry, your data is safe. This was just a small glitch. Tap the button below to restart Jarvis."
        android:textColor="#CCFFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="32dp" />

    <!-- Restart button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRestart"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="🔄  Restart Jarvis"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:paddingHorizontal="32dp"
        android:backgroundTint="#FF6C63FF"
        android:textColor="#FFFFFFFF"
        android:layout_marginBottom="16dp"
        style="@style/Widget.MaterialComponents.Button" />

    <!-- Close button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Close App"
        android:textSize="14sp"
        android:textAllCaps="false"
        android:paddingHorizontal="24dp"
        android:backgroundTint="#33FFFFFF"
        android:textColor="#99FFFFFF"
        style="@style/Widget.MaterialComponents.Button" />

</LinearLayout>
